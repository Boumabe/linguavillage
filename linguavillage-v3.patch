diff --git a/css/theme_v3.css b/css/theme_v3.css
new file mode 100644
index 0000000..307f69a
--- /dev/null
+++ b/css/theme_v3.css
@@ -0,0 +1,280 @@
+/* =================================================================
+   LinguaVillage — theme_v3.css  ·  Thème « Lagon »
+   Chargé EN DERNIER : redéfinit les jetons de couleur, puis restyle
+   le menu, la carte « Aujourd'hui », le village, le dialogue, les modales.
+   Palette : encre de lagon (fonds) · papaye (action) · menthe (succès) · sable (texte)
+   Typographie : Fraunces (titres) + Sora (interface)
+   ================================================================= */
+
+:root {
+  --accent:   #ff8a5b;
+  --accent-2: #37d6a5;
+  --accent-ink: #1a0d08;                 /* texte sur fond papaye */
+  --safe-top:    env(safe-area-inset-top, 0px);
+  --safe-bottom: env(safe-area-inset-bottom, 0px);
+  --shadow-1: 0 1px 0 rgba(255,255,255,0.04) inset, 0 12px 32px -14px rgba(0,0,0,0.65);
+  --tint-accent: #ff8a5b;  --tint-accent-bg: rgba(255,138,91,0.16);
+  --tint-mint:   #37d6a5;  --tint-mint-bg:   rgba(55,214,165,0.15);
+  --tint-sky:    #5ab8ff;  --tint-sky-bg:    rgba(90,184,255,0.15);
+  --tint-violet: #b79cff;  --tint-violet-bg: rgba(183,156,255,0.15);
+  --tint-amber:  #ffc15a;  --tint-amber-bg:  rgba(255,193,90,0.15);
+  --tint-rose:   #ff7eb6;  --tint-rose-bg:   rgba(255,126,182,0.15);
+}
+
+/* ── Base ─────────────────────────────────────────────────────── */
+body::after { display: none; }           /* grain plein écran : coûteux au-dessus du canvas 3D, retiré */
+:focus-visible { outline: 2px solid var(--accent-2); outline-offset: 2px; border-radius: 8px; }
+button, [role="button"], a { -webkit-tap-highlight-color: transparent; }
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
+}
+
+/* Barre de diagnostic : invisible pour les joueurs (visible avec ?debug) */
+#debug { display: none; }
+html.lv-debug #debug { display: block; position: fixed; top: 0; left: 0; right: 0; z-index: 100000; font: 11px/1.3 var(--font-mono); padding: 4px 8px; background: #1f6f9e; color: #fff; }
+html.lv-debug #debug:empty { display: none; }
+html.lv-debug #debug.err { background: #b0362b; }
+
+/* Petits boutons génériques */
+.lv-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0 20px; border-radius: 14px; border: 1px solid var(--border-mid); background: var(--surface-raised); color: var(--text-primary); font-weight: 700; font-size: 0.86rem; }
+.lv-btn.primary { background: linear-gradient(135deg, #ff9d75, #ff8a5b); border-color: transparent; color: var(--accent-ink); box-shadow: 0 8px 22px -8px rgba(255,138,91,0.6); }
+.lv-btn.ghost { background: transparent; color: var(--text-secondary); }
+.lv-btn:disabled { opacity: 0.45; }
+.lv-btn:active { transform: scale(0.97); }
+
+/* ── En-têtes des sous-écrans ─────────────────────────────────── */
+.u-header { display: flex; align-items: center; gap: 10px; padding: calc(var(--safe-top) + 10px) 14px 10px; background: var(--surface-deep); border-bottom: 1px solid var(--border-faint); position: sticky; top: 0; z-index: 5; }
+.back-btn { background: var(--surface-card); border: 1px solid var(--border-faint); color: var(--text-primary); border-radius: 999px; padding: 0 14px; min-height: 36px; font-size: 0.78rem; font-weight: 600; }
+.back-btn:active { transform: scale(0.96); }
+.u-title { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; letter-spacing: -0.005em; }
+
+/* ── MENU ─────────────────────────────────────────────────────── */
+#screen-menu .menu-header { display: flex; align-items: center; gap: 8px; padding: calc(var(--safe-top) + 12px) 16px 10px; background: linear-gradient(180deg, var(--surface-void) 40%, transparent); border: 0; position: sticky; top: 0; z-index: 6; backdrop-filter: none; -webkit-backdrop-filter: none; }
+.menu-player { font-weight: 700; font-size: 0.9rem; color: var(--text-primary); max-width: 34vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.menu-lang { font-size: 0.7rem; font-weight: 600; color: var(--text-secondary); background: var(--surface-glass); border: 1px solid var(--border-faint); border-radius: 999px; padding: 3px 10px; white-space: nowrap; }
+.mh-spacer { flex: 1; }
+.mh-chip { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--border-faint); background: var(--surface-card); color: var(--text-primary); font-size: 0.74rem; font-weight: 700; white-space: nowrap; }
+.mh-chip.gems { color: var(--amber); }
+.mh-chip .xp-bar-bg { display: inline-block; width: 40px; height: 4px; border-radius: 2px; background: rgba(255,255,255,0.1); overflow: hidden; }
+.xp-bar-fill { display: block; height: 100%; border-radius: 2px; background: linear-gradient(90deg, var(--accent), #ffb08f); transition: width 0.4s var(--ease-out); }
+.menu-xp-val { color: var(--gold-warm); }
+
+#screen-menu .menu-body { width: 100%; max-width: 560px; margin: 0 auto; padding: 2px 16px calc(28px + var(--safe-bottom)); }
+#screen-menu .menu-greeting { font-family: var(--font-display); font-weight: 600; font-size: 1.75rem; line-height: 1.15; letter-spacing: -0.015em; color: var(--text-primary); }
+#screen-menu .menu-greeting-sub { color: var(--text-secondary); font-size: 0.84rem; margin-top: 4px; }
+.section-title { font-size: 0.64rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-dim); margin: 18px 2px 10px; }
+
+/* Carte « Aujourd'hui » */
+.hero { display: grid; grid-template-columns: auto 1fr; gap: 14px 16px; align-items: center; padding: 16px; margin: 16px 0 6px; border-radius: 24px; border: 1px solid rgba(255,138,91,0.2); box-shadow: var(--shadow-1);
+  background: radial-gradient(120% 150% at 0% 0%, rgba(255,138,91,0.17), transparent 55%), linear-gradient(180deg, var(--surface-card), #0d2226); }
+.hero.done { border-color: rgba(55,214,165,0.35); background: radial-gradient(120% 150% at 0% 0%, rgba(55,214,165,0.16), transparent 55%), linear-gradient(180deg, var(--surface-card), #0d2226); }
+.hero-ring { position: relative; width: 78px; height: 78px; }
+.hero-ring svg { width: 100%; height: 100%; }
+.hero-ring circle { fill: none; stroke-width: 7; }
+.hero-ring .bg { stroke: rgba(255,255,255,0.08); }
+.hero-ring .fg { stroke: var(--accent); stroke-linecap: round; transition: stroke-dashoffset 0.7s var(--ease-out), stroke 0.3s; }
+.hero.done .hero-ring .fg { stroke: var(--accent-2); }
+.hero-ring-c { position: absolute; inset: 0; display: grid; place-items: center; }
+.hero-ring-c b { font-family: var(--font-display); font-size: 0.95rem; font-weight: 700; }
+.hero-info { min-width: 0; }
+.hero-label { font-size: 0.64rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-secondary); }
+.hero-streak { display: flex; align-items: baseline; gap: 6px; margin-top: 2px; }
+.hero-streak .flame { font-size: 1.15rem; align-self: center; }
+.hero-streak b { font-family: var(--font-display); font-size: 1.9rem; line-height: 1; color: var(--amber); }
+.hero-streak span:last-child { font-size: 0.74rem; color: var(--text-secondary); }
+.hero-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
+.hero-pill { display: inline-flex; align-items: center; min-height: 28px; padding: 0 10px; border-radius: 999px; font-size: 0.68rem; font-weight: 700; border: 1px solid var(--border-faint); background: var(--surface-glass-md); color: var(--text-primary); }
+.hero-pill[hidden] { display: none; }
+.hero-pill.boost { color: var(--accent); border-color: rgba(255,138,91,0.3); background: rgba(255,138,91,0.1); }
+.hero-pill.ghost { background: transparent; color: var(--text-secondary); }
+.hero-cta { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 50px; padding: 0 18px; border: 0; border-radius: 16px; background: linear-gradient(135deg, #ff9d75, #ff8a5b); color: var(--accent-ink); font-weight: 700; font-size: 0.92rem; box-shadow: 0 10px 26px -10px rgba(255,138,91,0.7); text-align: left; }
+.hero.done .hero-cta { background: linear-gradient(135deg, #5be3b9, #37d6a5); box-shadow: 0 10px 26px -10px rgba(55,214,165,0.6); }
+.hero-cta:active { transform: scale(0.98); }
+
+/* Grille des modes */
+#screen-menu .menu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
+#screen-menu .menu-card { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 3px; text-align: left; min-height: 122px; padding: 14px; border-radius: 20px; border: 1px solid var(--border-faint); background: var(--surface-card); box-shadow: none; color: var(--text-primary); font: inherit; transition: transform 0.15s var(--ease-out), border-color 0.2s; --tint: var(--tint-accent); --tint-bg: var(--tint-accent-bg); }
+#screen-menu .menu-card::before { display: none; }
+#screen-menu .menu-card:active { transform: scale(0.97); }
+@media (hover: hover) { #screen-menu .menu-card:hover { transform: translateY(-2px); border-color: var(--border-mid); } }
+#screen-menu .menu-card[data-mode="village"]   { --tint: var(--tint-accent); --tint-bg: var(--tint-accent-bg); }
+#screen-menu .menu-card[data-mode="vocab"]     { --tint: var(--tint-sky);    --tint-bg: var(--tint-sky-bg); }
+#screen-menu .menu-card[data-mode="phrases"]   { --tint: var(--tint-mint);   --tint-bg: var(--tint-mint-bg); }
+#screen-menu .menu-card[data-mode="grammar"]   { --tint: var(--tint-violet); --tint-bg: var(--tint-violet-bg); }
+#screen-menu .menu-card[data-mode="alphabet"]  { --tint: var(--tint-amber);  --tint-bg: var(--tint-amber-bg); }
+#screen-menu .menu-card[data-mode="dict"]      { --tint: var(--tint-sky);    --tint-bg: var(--tint-sky-bg); }
+#screen-menu .menu-card[data-mode="cinema"]    { --tint: var(--tint-rose);   --tint-bg: var(--tint-rose-bg); }
+#screen-menu .menu-card[data-mode="wordgame"]  { --tint: var(--tint-violet); --tint-bg: var(--tint-violet-bg); }
+#screen-menu .menu-card[data-mode="mnemonics"] { --tint: var(--tint-amber);  --tint-bg: var(--tint-amber-bg); }
+#screen-menu .menu-card.program                { --tint: var(--tint-mint);   --tint-bg: var(--tint-mint-bg); }
+#screen-menu .m-icon { display: grid; place-items: center; flex: 0 0 auto; width: 42px; height: 42px; margin: 0 0 8px; border-radius: 13px; background: var(--tint-bg); color: var(--tint); font-size: 1rem; }
+#screen-menu .m-icon svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
+#screen-menu .m-label { font-weight: 700; font-size: 0.92rem; color: var(--text-primary); display: block; }
+#screen-menu .m-desc { font-size: 0.7rem; color: var(--text-secondary); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
+#screen-menu .m-badge { position: absolute; top: 12px; right: 12px; margin: 0; padding: 2px 8px; border-radius: 999px; font-size: 0.58rem; font-weight: 800; letter-spacing: 0.05em; background: rgba(255,255,255,0.07); color: var(--text-secondary); }
+#screen-menu .m-badge.new { background: rgba(55,214,165,0.15); color: var(--accent-2); }
+#screen-menu .m-badge.alt, #screen-menu .m-badge.alt2 { background: var(--tint-bg); color: var(--tint); }
+
+#screen-menu .menu-card.wide { grid-column: 1 / -1; flex-direction: row; align-items: center; gap: 14px; min-height: 0; padding: 14px 16px; }
+#screen-menu .menu-card.wide .m-icon { margin: 0; }
+#screen-menu .menu-card.wide .m-text { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
+#screen-menu .menu-card.wide .m-badge { position: static; margin-left: auto; }
+#screen-menu .menu-card.wide[data-mode="village"] { min-height: 96px; border-color: rgba(255,138,91,0.28); background: linear-gradient(120deg, rgba(255,138,91,0.2), rgba(55,214,165,0.08) 70%), var(--surface-card); }
+#screen-menu .menu-card.wide[data-mode="village"] .m-icon { width: 52px; height: 52px; border-radius: 16px; background: rgba(255,138,91,0.22); }
+#screen-menu .menu-card.wide[data-mode="village"] .m-icon svg { width: 28px; height: 28px; }
+#screen-menu .menu-card.wide[data-mode="village"] .m-label { font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; }
+.m-chev { margin-left: auto; color: var(--text-dim); font-size: 1.3rem; }
+.m-pill { margin-left: auto; font-size: 0.66rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; background: var(--tint-mint-bg); color: var(--accent-2); white-space: nowrap; }
+
+/* ── VILLAGE : HUD, navigation, joystick, bouton Parler ─────────── */
+#screen-village .village-hud { background: rgba(7,20,23,0.9); backdrop-filter: none; -webkit-backdrop-filter: none; padding: calc(var(--safe-top) + 8px) 12px 8px; border-bottom: 1px solid var(--border-faint); min-height: 50px; }
+#screen-village .hud-pill { background: var(--surface-glass-md); border: 1px solid var(--border-faint); }
+#screen-village .hud-btn { min-height: 32px; }
+#screen-village .village-nav-bar { background: rgba(7,20,23,0.97); backdrop-filter: none; -webkit-backdrop-filter: none; border-top: 1px solid var(--border-faint); padding: 6px 4px max(6px, var(--safe-bottom)); }
+#screen-village .vnb-btn { position: relative; color: var(--text-dim); min-height: 48px; }
+#screen-village .vnb-btn.active { color: var(--accent); }
+#screen-village .vnb-btn.active::before { content: ''; position: absolute; top: -7px; width: 22px; height: 3px; border-radius: 0 0 3px 3px; background: var(--accent); }
+#screen-village .vnb-icon { display: grid; place-items: center; font-size: 1rem; }
+#screen-village .vnb-icon svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
+#screen-village .vnb-label { font-size: 0.6rem; font-weight: 600; letter-spacing: 0.02em; }
+
+.lv-joy { position: absolute; left: 18px; bottom: 18px; width: 112px; height: 112px; border-radius: 50%; z-index: 500; touch-action: none; background: radial-gradient(circle, rgba(255,255,255,0.1), rgba(255,255,255,0.02)); border: 1.5px solid rgba(255,255,255,0.3); box-shadow: 0 10px 28px rgba(0,0,0,0.35); }
+.lv-joy-handle { position: absolute; left: 50%; top: 50%; width: 48px; height: 48px; margin: -24px 0 0 -24px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #ffd6c4, var(--accent)); border: 2px solid rgba(255,255,255,0.75); box-shadow: 0 6px 16px rgba(255,138,91,0.45); pointer-events: none; will-change: transform; }
+.lv-talk { position: absolute; right: 16px; bottom: 26px; z-index: 500; display: flex; align-items: center; gap: 8px; max-width: calc(100% - 170px); padding: 10px 16px 10px 12px; border: 0; border-radius: 999px; background: linear-gradient(135deg, #ff9d75, #ff8a5b); color: var(--accent-ink); font-weight: 700; font-size: 0.84rem; box-shadow: 0 10px 26px rgba(255,138,91,0.45); animation: lv-pulse 1.9s ease-in-out infinite; }
+.lv-talk[hidden] { display: none; }
+.lv-talk-emoji { font-size: 1.25rem; line-height: 1; }
+.lv-talk-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+@keyframes lv-pulse { 0%, 100% { box-shadow: 0 10px 26px rgba(255,138,91,0.45), 0 0 0 0 rgba(255,138,91,0.5); } 50% { box-shadow: 0 10px 26px rgba(255,138,91,0.45), 0 0 0 10px rgba(255,138,91,0); } }
+
+.lv-react-bubble { position: fixed; right: 20px; bottom: 90px; z-index: 10000; padding: 8px 10px; font-size: 2.2rem; border-radius: 50%; background: rgba(7,20,23,0.8); pointer-events: none; animation: lv-fade 2s forwards; }
+@keyframes lv-fade { 0% { opacity: 1; transform: scale(1); } 70% { opacity: 1; } 100% { opacity: 0; transform: scale(0.6); } }
+
+/* ── DIALOGUE ─────────────────────────────────────────────────── */
+.dlg { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 9000; display: flex; flex-direction: column; background: linear-gradient(180deg, #081a1e, var(--surface-deep)); padding-bottom: var(--safe-bottom); animation: dlg-in 0.22s var(--ease-out); }
+.dlg.closing { opacity: 0; transform: translateY(14px); transition: opacity 0.2s, transform 0.2s; }
+@keyframes dlg-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
+.dlg-head { display: flex; align-items: center; gap: 12px; padding: calc(var(--safe-top) + 10px) 14px 10px; background: rgba(16,38,43,0.7); border-bottom: 1px solid var(--border-faint); }
+.dlg-close { order: 9; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--border-faint); background: var(--surface-card); color: var(--text-secondary); }
+.dlg-avatar { position: relative; flex: 0 0 auto; width: 48px; height: 48px; display: grid; place-items: center; border-radius: 50%; font-size: 1.6rem; background: radial-gradient(circle at 30% 25%, var(--surface-raised), var(--surface-card)); border: 2px solid rgba(255,138,91,0.5); transition: border-color 0.25s, box-shadow 0.25s; }
+.dlg-avatar[data-mood="happy"]    { border-color: var(--accent-2); box-shadow: 0 0 0 5px rgba(55,214,165,0.15); animation: dlg-bounce 0.6s var(--ease-spring); }
+.dlg-avatar[data-mood="confused"] { border-color: var(--amber);    animation: dlg-wobble 0.6s; }
+.dlg-avatar[data-mood="thinking"] { border-color: var(--tint-sky); animation: lv-pulse 1.2s infinite; }
+.dlg-avatar[data-mood="sad"]      { border-color: var(--coral); opacity: 0.85; }
+@keyframes dlg-bounce { 0%, 100% { transform: translateY(0); } 40% { transform: translateY(-7px); } }
+@keyframes dlg-wobble { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-8deg); } 75% { transform: rotate(8deg); } }
+.dlg-who { flex: 1; min-width: 0; }
+.dlg-name { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; line-height: 1.2; }
+.dlg-role { font-size: 0.72rem; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.dlg-mode { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; padding: 4px 9px; border-radius: 999px; background: rgba(55,214,165,0.14); color: var(--accent-2); }
+.dlg-mode.guided { background: rgba(255,193,90,0.14); color: var(--amber); }
+.dlg-immersion { display: flex; align-items: center; gap: 8px; padding: 7px 16px; font-size: 0.62rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-dim); border-bottom: 1px solid var(--border-faint); }
+.dlg-track { flex: 1; height: 4px; border-radius: 2px; background: rgba(255,255,255,0.08); overflow: hidden; }
+.dlg-track div { height: 100%; background: linear-gradient(90deg, var(--accent-2), var(--tint-sky)); border-radius: 2px; }
+.dlg-immersion b { color: var(--text-secondary); font-weight: 700; letter-spacing: 0.02em; text-transform: none; }
+
+.dlg-messages { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 14px; display: flex; flex-direction: column; gap: 10px; scroll-behavior: smooth; }
+.dlg-row { display: flex; }
+.dlg-row.player { justify-content: flex-end; }
+.dlg-bubble { position: relative; max-width: 86%; padding: 10px 14px; font-size: 0.94rem; line-height: 1.5; word-wrap: break-word; overflow-wrap: anywhere; }
+.dlg-row.npc .dlg-bubble { background: var(--surface-raised); border: 1px solid var(--border-faint); border-radius: 18px 18px 18px 6px; animation: dlg-pop 0.22s var(--ease-out); }
+.dlg-row.player .dlg-bubble { background: linear-gradient(135deg, #ff9d75, #ff8a5b); color: var(--accent-ink); font-weight: 600; border-radius: 18px 18px 6px 18px; animation: dlg-pop 0.18s var(--ease-out); }
+@keyframes dlg-pop { from { opacity: 0; transform: translateY(6px) scale(0.98); } to { opacity: 1; transform: none; } }
+.dlg-speak { display: inline-grid; place-items: center; vertical-align: middle; margin-left: 8px; width: 26px; height: 26px; border-radius: 50%; border: 0; background: rgba(255,255,255,0.08); color: var(--text-secondary); }
+.dlg-sub { display: none; margin-top: 7px; padding-top: 7px; border-top: 1px dashed rgba(255,255,255,0.16); color: var(--text-secondary); font-size: 0.8rem; }
+.dlg-bubble.sub-open .dlg-sub { display: block; }
+.dlg-bubble.has-sub:not(.sub-open)::after { content: 'Aあ'; position: absolute; right: 8px; bottom: -8px; padding: 1px 6px; border-radius: 999px; font-size: 0.56rem; font-weight: 800; background: var(--surface-card); border: 1px solid var(--border-mid); color: var(--text-secondary); }
+.dlg-bubble.tone-ok   { border-color: rgba(55,214,165,0.45) !important; }
+.dlg-bubble.tone-warn { border-color: rgba(255,193,90,0.5) !important; }
+.dlg-bubble.tone-gold { border-color: rgba(255,138,91,0.6) !important; background: linear-gradient(135deg, rgba(255,138,91,0.16), var(--surface-raised)) !important; }
+.dlg-dots { display: inline-flex; gap: 5px; padding: 4px 2px; }
+.dlg-dots i { width: 7px; height: 7px; border-radius: 50%; background: var(--text-secondary); animation: dlg-dot 1s infinite; }
+.dlg-dots i:nth-child(2) { animation-delay: 0.15s; } .dlg-dots i:nth-child(3) { animation-delay: 0.3s; }
+@keyframes dlg-dot { 0%, 60%, 100% { transform: translateY(0); opacity: 0.4; } 30% { transform: translateY(-5px); opacity: 1; } }
+
+.dlg-choices { display: none; padding: 10px 14px 14px; flex-direction: column; gap: 8px; border-top: 1px solid var(--border-faint); background: var(--surface-deep); }
+.dlg-choices[style*="block"] { display: flex !important; }
+.dlg-prog { display: flex; align-items: center; gap: 10px; font-size: 0.66rem; color: var(--text-dim); font-weight: 700; }
+.dlg-prog-track { flex: 1; height: 4px; border-radius: 2px; background: rgba(255,255,255,0.08); overflow: hidden; }
+.dlg-prog-track div { height: 100%; background: var(--amber); border-radius: 2px; transition: width 0.4s; }
+.dlg-choice { text-align: left; min-height: 50px; padding: 12px 16px; border-radius: 16px; border: 1.5px solid var(--border-mid); background: var(--surface-card); color: var(--text-primary); font-size: 0.92rem; font-weight: 600; transition: transform 0.12s, border-color 0.2s, background 0.2s; }
+.dlg-choice:active:not(:disabled) { transform: scale(0.985); }
+.dlg-choice.correct { border-color: var(--accent-2); background: rgba(55,214,165,0.14); }
+.dlg-choice.wrong { border-color: var(--coral); background: rgba(255,107,127,0.12); animation: dlg-wobble 0.4s; }
+.dlg-choice.dim { opacity: 0.4; }
+.dlg-fillprompt { padding: 12px 14px; border-radius: 14px; background: var(--surface-card); border: 1px solid var(--border-faint); font-size: 0.95rem; }
+.dlg-blank { display: inline-block; min-width: 46px; border-bottom: 2px solid var(--accent); text-align: center; color: var(--accent); }
+.dlg-fillrow { display: flex; gap: 8px; }
+.dlg-fillinput { flex: 1; min-width: 0; height: 48px; padding: 0 16px; border-radius: 14px; border: 1.5px solid var(--border-mid); background: var(--surface-card); color: var(--text-primary); font-size: 1rem; }
+.dlg-fillinput.correct { border-color: var(--accent-2); } .dlg-fillinput.wrong { border-color: var(--coral); }
+.dlg-fillbtn { width: 52px; border: 0; border-radius: 14px; background: linear-gradient(135deg, #ff9d75, #ff8a5b); color: var(--accent-ink); font-weight: 800; font-size: 1.1rem; }
+
+.dlg-free { padding: 8px 12px 12px; background: var(--surface-deep); border-top: 1px solid var(--border-faint); }
+.dlg-chips { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 8px; scrollbar-width: none; }
+.dlg-chips::-webkit-scrollbar { display: none; }
+.dlg-chips.hide { display: none; }
+.dlg-chip { flex: 0 0 auto; min-height: 34px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--border-mid); background: var(--surface-card); color: var(--text-secondary); font-size: 0.78rem; font-weight: 600; white-space: nowrap; }
+.dlg-inputrow { display: flex; align-items: center; gap: 8px; }
+.dlg-inputrow input { flex: 1; min-width: 0; height: 48px; padding: 0 18px; border-radius: 24px; border: 1.5px solid var(--border-mid); background: var(--surface-card); color: var(--text-primary); font-size: 1rem; outline: none; }
+.dlg-inputrow input:focus { border-color: var(--accent); }
+.dlg-icon-btn, .dlg-send { flex: 0 0 auto; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--border-mid); background: var(--surface-card); color: var(--text-secondary); }
+.dlg-icon-btn[style*="display: none"] { display: none !important; }
+.dlg-icon-btn.rec { background: rgba(255,107,127,0.16); border-color: var(--coral); color: var(--coral); animation: lv-pulse 1.1s infinite; }
+.dlg-send { border: 0; background: linear-gradient(135deg, #ff9d75, #ff8a5b); color: var(--accent-ink); box-shadow: 0 8px 20px -8px rgba(255,138,91,0.7); }
+.dlg-send:disabled { opacity: 0.5; }
+.dlg-xp { height: 3px; background: rgba(255,255,255,0.05); }
+.dlg-xp-fill { height: 100%; width: 0; background: linear-gradient(90deg, var(--accent), #ffb08f); transition: width 0.5s var(--ease-out); }
+
+/* ── MODALES (coffres) ────────────────────────────────────────── */
+.lv-modal { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 9500; display: grid; place-items: center; padding: 24px; background: rgba(4,14,17,0.82); animation: dlg-in 0.2s; }
+.lv-modal.closing { opacity: 0; transition: opacity 0.18s; }
+.lv-modal-card { width: 100%; max-width: 340px; padding: 26px 22px 22px; text-align: center; border-radius: 28px; background: radial-gradient(120% 90% at 50% 0%, rgba(255,138,91,0.16), transparent 60%), var(--surface-card); border: 1px solid rgba(255,138,91,0.25); box-shadow: 0 30px 70px rgba(0,0,0,0.6); }
+.lv-chest-name { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; margin-bottom: 14px; }
+.lv-chest-box { width: 108px; height: 108px; margin: 0 auto 14px; display: grid; place-items: center; border-radius: 30px; background: radial-gradient(circle, color-mix(in srgb, var(--chest, #ff8a5b) 30%, transparent), transparent 70%); animation: chest-shake 0.5s 0.15s 2; }
+.lv-chest-icon { font-size: 4rem; filter: drop-shadow(0 8px 16px rgba(0,0,0,0.4)); transition: transform 0.4s var(--ease-spring); }
+.lv-chest-box.open .lv-chest-icon { transform: scale(1.25) translateY(-6px); }
+@keyframes chest-shake { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-7deg); } 75% { transform: rotate(7deg); } }
+.lv-chest-reward { min-height: 34px; font-size: 1.15rem; opacity: 0; transform: translateY(8px); transition: all 0.35s var(--ease-out); }
+.lv-chest-reward.show { opacity: 1; transform: none; }
+.lv-chest-reward b { font-family: var(--font-display); font-size: 1.6rem; color: var(--accent); }
+.lv-chest-ok { margin-top: 12px; width: 100%; }
+.lv-chest-ok[hidden] { display: none; }
+
+/* ── BOUTIQUE ─────────────────────────────────────────────────── */
+#shopItems { display: grid !important; grid-template-columns: 1fr !important; gap: 12px !important; max-width: 560px; margin: 0 auto; width: 100%; }
+.lv-shop-item { display: grid; grid-template-columns: 52px 1fr auto; grid-template-areas: "ic name btn" "ic desc btn"; align-items: center; column-gap: 14px; padding: 14px 16px; border-radius: 18px; background: var(--surface-card); border: 1px solid var(--border-faint); }
+.lv-shop-ic { grid-area: ic; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 16px; background: var(--tint-accent-bg); font-size: 1.6rem; }
+.lv-shop-name { grid-area: name; font-weight: 700; font-size: 0.92rem; } .lv-shop-name small { color: var(--text-secondary); font-weight: 600; }
+.lv-shop-desc { grid-area: desc; font-size: 0.74rem; color: var(--text-secondary); }
+.lv-shop-item .lv-btn { grid-area: btn; min-height: 42px; padding: 0 16px; }
+.lv-shop-tip { text-align: center; font-size: 0.74rem; color: var(--text-dim); padding: 8px 12px; }
+
+/* ── DICTIONNAIRE (compléments) ───────────────────────────────── */
+.dict-hist-label { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-dim); margin: 18px 0 8px; }
+.dict-query { font-size: 0.78rem; color: var(--text-secondary); margin-bottom: 6px; }
+.dict-grammar { font-size: 0.78rem; color: var(--text-secondary); margin-top: 8px; }
+
+/* ── Notification ─────────────────────────────────────────────── */
+#notif { bottom: calc(90px + var(--safe-bottom)); max-width: 88vw; text-align: center; }
+
+/* ── Grands écrans : le menu reste lisible ────────────────────── */
+@media (min-width: 720px) {
+  .dlg { left: 50%; right: auto; width: 560px; transform: translateX(-50%); border-left: 1px solid var(--border-faint); border-right: 1px solid var(--border-faint); animation: none; }
+  .dlg.closing { transform: translateX(-50%); }
+}
+
+/* ── Barre de navigation du village (style de base — auparavant injecté par JS) ── */
+.village-nav-bar { flex-shrink: 0; display: flex; align-items: stretch; justify-content: space-around; z-index: 30; }
+.vnb-btn { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; background: none; border: none; padding: 6px 0; transition: color 0.18s; }
+.vnb-btn:active { opacity: 0.7; }
+.vnb-btn.active .vnb-icon { transform: scale(1.12); }
+.vnb-icon { transition: transform 0.18s; }
+
+/* Ajustements d'espacement (menu, boutique) */
+#screen-menu .menu-greeting { margin: 4px 0 0; }
+#screen-menu .menu-greeting-sub { margin: 4px 0 0; }
+.hero { margin: 14px 0 4px; }
+.lv-shop-item { grid-template-rows: auto auto; row-gap: 3px; align-content: center; align-items: center; min-height: 0; height: auto; }
+.lv-shop-ic { grid-row: 1 / span 2; align-self: center; }
+.lv-shop-item .lv-btn { grid-row: 1 / span 2; align-self: center; }
+.lv-shop-name, .lv-shop-desc { align-self: end; margin: 0; }
+.lv-shop-desc { align-self: start; }
