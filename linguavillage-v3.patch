+      card.innerHTML =
+        '<div class="lv-shop-ic">' + it.icon + '</div>' +
+        '<div class="lv-shop-name">' + LV.esc(it.name) + (owned != null ? ' <small>×' + owned + '</small>' : '') + '</div>' +
+        '<div class="lv-shop-desc">' + LV.esc(it.desc) + '</div>';
