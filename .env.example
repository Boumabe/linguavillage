# Variables d'environnement à définir dans Vercel (Project → Settings → Environment Variables)
# — ne JAMAIS écrire la vraie clé dans le code ni la commiter.
GEMINI_API_KEY=colle-ta-cle-ici
# Optionnel : modèles essayés dans l'ordre (le 2e sert de secours)
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# Optionnel : origines supplémentaires autorisées (séparées par des virgules)
# ALLOWED_ORIGINS=https://monsite.exemple
